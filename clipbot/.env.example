# ---- Activation ----
GAME_NAME=Grand Theft Auto VI
ACTIVATE_AT=2026-11-19T00:00:00Z
POLL_SECONDS=300
# Only clips from these Twitch logins (comma-separated) - streamers who gave you permission
ALLOWED_BROADCASTERS=
MIN_CLIP_VIEWS=50
LOOKBACK_HOURS=24
# true = AI writes commentary, Kokoro voices it, you review/edit the script in the dashboard
COMMENTARY_MODE=true
# true = post automatically, false = wait for approval in the dashboard
AUTO_APPROVE=false

# ---- Commentary ----
# Anthropic API key for script writing: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Kokoro voices: am_michael am_fenrir am_puck am_adam bm_george af_heart af_bella bf_emma
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.05
WHISPER_MODEL=base.en

# ---- Twitch (https://dev.twitch.tv/console/apps) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- YouTube (Google Cloud OAuth client, run scripts/youtube_auth.py) ----
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=public
YT_DAILY_LIMIT=6

# ---- Instagram (Meta app, Business/Creator account) ----
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.facebook.com
IG_API_VERSION=v23.0
IG_DAILY_LIMIT=25

# ---- Dashboard ----
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
DATA_DIR=./data
