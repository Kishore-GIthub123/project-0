# ClipBot configuration. Copy to .env and edit.  (Windows: copy .env.example .env ; notepad .env)

# ---- Activation / sources ----
GAME_NAME=Grand Theft Auto VI
ACTIVATE_AT=2026-11-19T00:00:00Z
POLL_SECONDS=300
# Only clips from these Twitch logins (comma-separated) - streamers who gave you permission
ALLOWED_BROADCASTERS=
MIN_CLIP_VIEWS=50
LOOKBACK_HOURS=24
# Keep false: every video waits for your approval in the dashboard
AUTO_APPROVE=false

# ---- Commentary (AI script + Kokoro voice) ----
COMMENTARY_MODE=true
# storytelling | funny | hype   (can be changed per clip in the dashboard)
COMMENTARY_STYLE=storytelling

# ---- AI provider: ollama (local, free, default) or anthropic (optional, paid) ----
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=4096
# empty = Ollama decides (uses the GPU if it can) ; 0 = force CPU only
OLLAMA_NUM_GPU=
OLLAMA_KEEP_ALIVE=5m
# qwen3 can "think" before answering; false = faster, direct answers. omit = don't send the option.
OLLAMA_THINK=false
AI_RETRIES=2
AI_MAX_CONCURRENT=1
AI_MAX_TRANSCRIPT_CHARS=4000
AI_MAX_SCRIPT_WORDS=140
# Fewer spoken words than this -> clip goes to manual review instead of AI commentary
AI_MIN_TRANSCRIPT_WORDS=8
# Only used when AI_PROVIDER=anthropic (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ---- Speech ----
# Kokoro voices: am_michael am_fenrir am_puck am_adam bm_george af_heart af_bella bf_emma
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.05
KOKORO_SENTENCE_PAUSE_MS=180
# JSON file of respellings for the narrator (default: clipbot/pronunciations.json)
PRONUNCIATION_FILE=
WHISPER_MODEL=base.en
# cpu (default) or cuda (only if CUDA 12 + cuDNN are installed and verified)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Models are only downloaded by scripts/download_models.py unless this is true
AUTO_DOWNLOAD_SPEECH_MODELS=false

# ---- Audio mix ----
NARRATION_DELAY_MS=300
TARGET_LUFS=-14
GAME_VOLUME=0.8
DUCK_RATIO=10

# ---- Video ----
# pop (animated word highlight) | clean (static white) | none
CAPTION_STYLE=pop
CAPTION_FONT=Arial
CAPTION_FONT_SIZE=72
CAPTION_COLOR=#FFFFFF
CAPTION_HIGHLIGHT_COLOR=#FFD400
# lower | center | upper
CAPTION_POSITION=lower
CAPTION_WORDS=4
WATERMARK_TEXT=
# Small "Clip: <streamer> on Twitch" label in the corner
SOURCE_LABEL=true
KEEP_INTERMEDIATE_FILES=false
# Leave empty to find ffmpeg/ffprobe on PATH, or give full paths
FFMPEG_BIN=
FFPROBE_BIN=

# ---- Twitch (https://dev.twitch.tv/console/apps) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- YouTube (Google Cloud OAuth client, run scripts/youtube_auth.py) ----
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# private until you change it - nothing is published publicly by default
YT_PRIVACY=private
YT_DAILY_LIMIT=6

# ---- Instagram (Meta app, Business/Creator account) ----
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.facebook.com
IG_API_VERSION=v23.0
IG_DAILY_LIMIT=25

# ---- Dashboard ----
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
DATA_DIR=./data
